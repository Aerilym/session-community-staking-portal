{
  "extends": "@session/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/componets/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/providers/*": ["./providers/*"],
      "wagmi": ["../../packages/contracts/node_modules/wagmi"],
      "wagmi/*": ["../../packages/contracts/node_modules/wagmi/*"],
      "@wagmi/core": ["../../packages/contracts/node_modules/@wagmi/core"],
      "@wagmi/core/*": ["../../packages/contracts/node_modules/@wagmi/core/*"],
      "@wagmi/connectors": ["../../packages/contracts/node_modules/@wagmi/connectors"],
      "@wagmi/connectors/*": ["../../packages/contracts/node_modules/@wagmi/connectors/*"],
      "viem": ["../../packages/contracts/node_modules/viem"],
      "viem/*": ["../../packages/contracts/node_modules/viem/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.js",
    "tailwind.config.ts",
    "postcss.config.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tests/**.ts",
    "jest.config.js"
  ],
  "exclude": ["node_modules"]
}
