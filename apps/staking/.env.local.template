NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_NETWORK_API_URL=
NEXT_PUBLIC_BACKEND_API_URL=
FAUCET_WALLET_PRIVATE_KEY=
FAUCET_DB_SECRET_KEY=
NEXT_PUBLIC_PRICE_TOKEN=
NEXT_PUBLIC_TESTNET=
NEXT_PUBLIC_ENV_FLAG= pick from dev, qa, stg, prd
NEXT_PUBLIC_POINTS_PROGRAM_API=

# Node notifications (web push)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=
# Optional: subject mailto used for VAPID (defaults to a placeholder)
NOTIFICATIONS_VAPID_SUBJECT=
# Optional: absolute or app-relative path for the notifications sqlite db (defaults to db/notifications.sqlite)
NOTIFICATIONS_DB_PATH=
# Optional: seconds between worker polls of the staking backend (defaults to 120)
NOTIFICATIONS_POLL_INTERVAL_SECONDS=
# Optional: subscriptions not seen for this many days are expired and deleted (defaults to 90)
NOTIFICATIONS_SUBSCRIPTION_EXPIRY_DAYS=
# Optional: extra push-service endpoint host suffixes to allow, comma-separated (e.g. for browsers with their own push relay)
NOTIFICATIONS_EXTRA_PUSH_HOSTS=
# Optional: set to 'false' to disable the background push worker on this instance (defaults to true)
NOTIFICATIONS_WORKER_ENABLED=
