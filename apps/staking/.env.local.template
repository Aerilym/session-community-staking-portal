# WalletConnect project ID (cloud.walletconnect.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Backend API URL
NEXT_PUBLIC_BACKEND_API_URL=
# Network API URL
NEXT_PUBLIC_NETWORK_API_URL=
# SESH token explorer base URL (defaults to https://seshtoken.info)
NEXT_PUBLIC_SESH_TOKEN_EXPLORER_URL=
# Operator info API base URL, used for the server-side /api/operators proxy and
# prefetch (defaults to https://seshtoken.info; can point at a local
# seshtoken.info instance, e.g. http://localhost:3000)
OPERATOR_INFO_API_URL=
# Price token for USD lookups (network API token slug, e.g. session-token)
NEXT_PUBLIC_PRICE_TOKEN=

# Feature flag environment: dev | qa | stg | prd
NEXT_PUBLIC_ENV_FLAG=stg
# 'true' to use testnet (Arbitrum Sepolia)
NEXT_PUBLIC_TESTNET=
# 'true' to show the canary indicator in the header
NEXT_PUBLIC_IS_CANARY=

# Optional custom RPC URLs and 'true' to batch RPC requests
NEXT_PUBLIC_RPC_URL_ETH=
NEXT_PUBLIC_RPC_URL_ARB=
NEXT_PUBLIC_RPC_BATCH_ETH=
NEXT_PUBLIC_RPC_BATCH_ARB=

# Claim service fee: no fee unless the address is set.
# Mode is the default payment asset ('eth' default or 'sesh'); users can opt
# into paying in SESH via a checkbox in the claim dialog. BPS applies to the
# amount being claimed (50 = 0.5%); it is converted between SESH and ETH at
# live network API prices — the ETH fee option is unavailable without them.
NEXT_PUBLIC_FEE_ADDRESS=
NEXT_PUBLIC_FEE_MODE=eth
# Flat fee in atomic SESH
NEXT_PUBLIC_FEE_FLAT_WEI=
# Flat fee in wei (adds to the converted BPS fee for ETH payments)
NEXT_PUBLIC_FEE_ETH_WEI=
NEXT_PUBLIC_FEE_BPS=
NEXT_PUBLIC_FEE_ENABLED_FLOWS=claim

# Referral code generation
NEXT_PUBLIC_SALT=
NEXT_PUBLIC_PEPPER=

# Points program API URL
NEXT_PUBLIC_POINTS_PROGRAM_API=

# Faucet ('true' to enable)
NEXT_PUBLIC_ENABLE_FAUCET=
FAUCET_WALLET_PRIVATE_KEY=
FAUCET_DB_SECRET_KEY=
FAUCET_HOURS_BETWEEN_USES=
FAUCET_MINUTES_BETWEEN_OPERATOR_TABLE_UPDATES=

# 'true' to enable the leaderboard
NEXT_PUBLIC_ENABLE_LEADERBOARD=

# 'true' to disable minification in production builds
NO_MINIFY=
# 'true' to enable debug assertions and logging
APP_DEBUG=

# Node notifications (web push)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NOTIFICATIONS_VAPID_PRIVATE_KEY=
# Optional: subject mailto used for VAPID (defaults to a placeholder)
NOTIFICATIONS_VAPID_SUBJECT=
# Optional: absolute or app-relative path for the notifications sqlite db (defaults to db/notifications.sqlite)
NOTIFICATIONS_DB_PATH=
# Optional: absolute or app-relative path for the feature flags sqlite db (defaults to db/flags.sqlite)
FLAGS_DB_PATH=
# Optional: seconds between worker polls of the staking backend (defaults to 120)
NOTIFICATIONS_POLL_INTERVAL_SECONDS=
# Optional: subscriptions not seen for this many days are expired and deleted (defaults to 90)
NOTIFICATIONS_SUBSCRIPTION_EXPIRY_DAYS=
# Optional: extra push-service endpoint host suffixes to allow, comma-separated (e.g. for browsers with their own push relay)
NOTIFICATIONS_EXTRA_PUSH_HOSTS=
# Optional: set to 'false' to disable the background push worker on this instance (defaults to true)
NOTIFICATIONS_WORKER_ENABLED=
