# Copy to .env.deploy and fill in; deploy.sh loads it automatically.
# Values here are overridden by variables already set in the environment.

# SSH target to deploy to
DEPLOY_REMOTE=root@host
# Remote directory to rsync the standalone build into
DEPLOY_PATH=/root/stake
# Optional: command run on the remote after rsync (quote values with spaces)
DEPLOY_RESTART_CMD=
